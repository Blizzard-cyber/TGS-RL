{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "required": ["existingConfigMap", "mountPath", "items"],
      "properties": {
        "existingConfigMap": {"type": "string"},
        "mountPath": {"type": "string", "pattern": "^/[^[:space:]]+$"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "path"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "scheduler": {
      "allOf": [
        {"$ref": "#/definitions/statefulGoService"},
        {
          "type": "object",
          "properties": {
            "nvidia": {
              "type": "object",
              "required": ["enabled", "image", "partitionMode", "dryRun", "commandTimeout", "runtimeClassName", "nodeSelector", "visibleDevices", "driverCapabilities"],
              "properties": {
                "enabled": {"type": "boolean"},
                "image": {"$ref": "#/definitions/image"},
                "partitionMode": {"type": "string", "enum": ["auto", "full", "mps", "mig"]},
                "dryRun": {"type": "boolean"},
                "commandTimeout": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
                "runtimeClassName": {"type": "string"},
                "nodeSelector": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
                "visibleDevices": {"type": "string", "minLength": 1},
                "driverCapabilities": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "runtime": {"$ref": "#/definitions/statefulPythonService"},
    "jobController": {"$ref": "#/definitions/statefulGoService"},
    "gateway": {"$ref": "#/definitions/httpService"},
    "console": {"$ref": "#/definitions/httpService"}
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"}
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "accessModes", "size", "retain"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "size": {"type": "string", "minLength": 1},
        "retain": {"type": "boolean"}
      }
    },
    "statefulGoService": {
      "type": "object",
      "required": ["image", "service", "persistence"],
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "service": {"type": "object"},
        "persistence": {"$ref": "#/definitions/persistence"}
      }
    },
    "statefulPythonService": {"$ref": "#/definitions/statefulGoService"},
    "httpService": {
      "type": "object",
      "required": ["image", "service"],
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "service": {"type": "object"}
      }
    }
  }
}
