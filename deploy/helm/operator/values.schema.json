{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$",
          "description": "Immutable image digest. Required for production; an empty value permits the local-development tag fallback."
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "gpuProfile": {
          "type": "string",
          "pattern": "^(none|kubernetes-dra|hami-vgpu|nvidia-device-plugin|volcano-hami)(,(none|kubernetes-dra|hami-vgpu|nvidia-device-plugin|volcano-hami))*$",
          "description": "Ordered comma-separated workload realization profiles. Each Binding selects the first compatible exact-identity profile."
        },
        "workerBootstrap": {
          "type": "object",
          "required": ["enabled", "installerImage", "registryURL", "registrySigningKeySecret", "registrySigningKeyKey", "verifyDeviceIdentities", "hostNetwork"],
          "properties": {
            "enabled": {"type": "boolean"},
            "installerImage": {"type": "string", "pattern": "^(|[^@[:space:]]+@sha256:[a-f0-9]{64})$"},
            "registryURL": {"type": "string", "pattern": "^(|https?://[^[:space:]]+)$"},
            "registrySigningKeySecret": {"type": "string", "pattern": "^(|[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?)$"},
            "registrySigningKeyKey": {"type": "string", "minLength": 1},
            "verifyDeviceIdentities": {"type": "boolean"},
            "hostNetwork": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      }
    }
  }
}
