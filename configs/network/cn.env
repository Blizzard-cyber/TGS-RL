: "${TGSRL_DOCKER_REGISTRY_MIRRORS:=https://docker.m.daocloud.io}"
: "${TGSRL_MINIKUBE_IMAGE_MIRROR_COUNTRY:=cn}"
: "${TGSRL_MINIKUBE_IMAGE_REPOSITORY:=auto}"
: "${TGSRL_MINIKUBE_BASE_IMAGE:=m.daocloud.io/gcr.io/k8s-minikube/kicbase:v0.0.50@sha256:eb4fec00e8ad70adf8e6436f195cc429825ffb85f95afcdb5d8d9deb576f3e93}"
