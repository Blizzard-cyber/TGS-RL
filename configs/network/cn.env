# Public mirrors for hosts in mainland China. Every value can be overridden by
# an already-exported environment variable. Tool archives are still verified
# against checksums fetched from their canonical upstream locations.
: "${TGSRL_DOWNLOAD_MIRROR_PREFIX:=https://files.m.daocloud.io}"
: "${TGSRL_PYPI_INDEX_URL:=https://pypi.tuna.tsinghua.edu.cn/simple}"
: "${UV_DEFAULT_INDEX:=${TGSRL_PYPI_INDEX_URL}}"
