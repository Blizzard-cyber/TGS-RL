    "version": "1.0.0",
    "phaseGraph": {
      "phases": [{"phaseId": "decode", "displayName": "GPU Smoke", "kind": "PHASE_KIND_DECODE", "parallelism": 1, "maxAttempts": 1}],
      "entryPhaseIds": ["decode"]
