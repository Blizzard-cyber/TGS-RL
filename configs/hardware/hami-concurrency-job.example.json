  "resourcesPerUnit": {"cpuMillis": "2000", "memoryBytes": "8589934592", "acceleratorUnits": 0.4},
  "requiredCapabilities": {"names": ["nvidia-gpu"], "algorithms": ["grpo"], "rolloutModes": ["partially_async"], "supportedActions": ["bind"]},
  "desiredUnits": 2,
  "priority": 1,
  "queue": "hami",
  "rolloutMode": "ROLLOUT_MODE_PARTIALLY_ASYNC",
