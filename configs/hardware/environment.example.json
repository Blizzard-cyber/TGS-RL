{
  "schema_version": "tgsrl.io/hardware-environment/v1alpha1",
  "state_directory": "/var/lib/tgsrl-hardware-driver",
  "defaults": {
    "gateway_url": "http://tgsrl-gateway.tgsrl.svc.cluster.local:8080",
    "worker_registry_url": "",
    "namespace": "tgsrl-workloads",
    "kube_context": "tgsrl-validation",
    "kubectl": "kubectl",
    "job_template": "./verl-job.example.json",
    "variables": {
      "WORKLOAD_IMAGE": "registry.example.com/tgsrl/gpu-smoke@sha256:replace-with-64-hex-characters",
      "WORKLOAD_IMAGE_DIGEST": "sha256:replace-with-64-hex-characters"
    },
    "trace_command": ["sh", "-c", "test -f /tmp/tgsrl/verl.ndjson && cat /tmp/tgsrl/verl.ndjson"],
    "operation_timeout_seconds": 1800,
    "poll_interval_seconds": 2
  },
  "targets": {
    "E1": {
      "gpu_profile": "full-gpu"
    },
    "E2": {
      "gpu_profile": "mig",
      "action_hooks": {
        "rebind": [
          "/opt/tgsrl/bin/submit-rebind-observation",
          "--request",
          "${REQUEST_PATH}",
          "--response",
          "${RESPONSE_PATH}"
        ]
      }
    },
    "A10-FULL": {
      "gpu_profile": "full-gpu",
      "job_template": "./verl-lifecycle-job.example.json"
    },
    "E5-STATIC": {
      "gpu_profile": "full-gpu",
      "execution_mode": "hami-vgpu",
      "job_template": "./e5-interference-job.example.json"
    },
    "E6": {
      "gpu_profile": "full-gpu",
      "execution_mode": "kubernetes-dra",
      "job_template": "./e6-action-cost-job.example.json"
    },
    "H1": {
      "gpu_profile": "full-gpu",
      "execution_mode": "hami-vgpu",
      "job_template": "./hami-job.example.json"
    },
    "H2": {
      "gpu_profile": "full-gpu",
      "execution_mode": "hami-vgpu",
      "job_template": "./hami-concurrency-job.example.json"
    }
  }
}
