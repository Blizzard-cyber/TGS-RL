      "requirements": {
        "minimum_nodes": 1,
        "minimum_accelerators": 1,
        "gpu_profiles": ["mig"],
        "execution_modes": ["kubernetes-dra"],
        "exact_device_identity": true,
        "required_actions": ["bind", "rebind"],
        "required_events": ["worker_registered", "device_identity_verified"],
        "required_faults": []
      },
      "rules": [
        {"rule_id": "e2-actions-succeed", "metric": "action_success_rate", "comparison": "variant", "operator": ">=", "threshold": 1}
      ]
