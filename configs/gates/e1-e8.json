{
  "schema_version": "tgsrl.io/gate-campaign/v1alpha1",
  "campaign_id": "tgsrl-e1-e8",
  "campaign_revision": 1,
  "description": "Release validation matrix. Null thresholds are intentionally blocked until the authoritative requirement values are supplied.",
  "experiments": [
    {
      "experiment_id": "E1",
      "title": "Full GPU exact-device execution",
      "gate_manifest": "configs/gates/gate-e1-e8-hardware.json",
      "scenario_manifest": "configs/scenarios/e1-full-gpu.yaml",
      "output_directory": "e1-full-gpu",
      "minimum_evidence": "GPU_SINGLE_NODE",
      "requirements": {
        "minimum_nodes": 1,
        "minimum_accelerators": 1,
        "gpu_profiles": ["full-gpu"],
        "execution_modes": ["kubernetes-dra"],
        "exact_device_identity": true,
        "required_actions": ["bind"],
        "required_events": ["worker_registered", "device_identity_verified"],
        "required_faults": []
      },
      "rules": [
        {"rule_id": "e1-actions-succeed", "metric": "action_success_rate", "comparison": "variant", "operator": ">=", "threshold": 1}
      ]
    },
    {
      "experiment_id": "E2",
      "title": "MIG exact-device execution",
      "gate_manifest": "configs/gates/gate-e1-e8-hardware.json",
