{
  "schema_version": "tgsrl.io/gate-suite/v1alpha1",
  "suite_id": "gate-g-i",
  "suite_revision": 1,
  "title": "Gate G/I validation",
  "scenario_manifest": "configs/scenarios/gate-gi.yaml",
  "workload_lock": {
    "algorithm": "grpo",
    "rollout_mode": "partially_async",
    "seed": 20260829,
    "version_lock": {
      "policy": "static",
      "scenario_revision": 1,
      "compatibility_profile": "cpu-mock-v1"
    }
  },
  "environment_fingerprint": {
    "required_fields": [
      "host_hash",
      "platform",
      "python_version",
      "git_commit",
      "execution_mode"
    ]
  },
  "artifacts": {
    "archive": "artifacts/raw/archive.tar.gz",
    "baseline_trace": "artifacts/traces/baseline-trace.json",
    "variant_trace": "artifacts/traces/variant-trace.json",
    "report": "report.json"
  },
  "metrics_schema": {
    "required_metrics": [
      "latency_ms_p50",
      "latency_ms_p95",
      "throughput_items_per_s",
      "decision_count"
    ]
  },
  "comparisons": {
    "baseline": "baseline",
    "variant": "variant",
    "warmup_runs": 1,
    "measurement_runs": 3
  },
  "rules": [
    {
      "rule_id": "gate-g-replay-artifacts-present",
      "gate": "G",
      "metric": "decision_count",
      "operator": ">=",
      "threshold": 1,
      "requires_trace": true
    },
    {
      "rule_id": "gate-i-throughput-regression-bound",
      "gate": "I",
      "metric": "throughput_items_per_s",
      "operator": ">=",
      "threshold": 0.95,
      "comparison": "variant_over_baseline_ratio"
    }
  ],
  "status_values": [
    "NOT_RUN",
    "BLOCKED",
    "INVALID",
    "PASSED",
    "FAILED"
  ],
  "evidence_values": [
    "SIMULATED",
    "CPU_INTEGRATION",
    "GPU_SINGLE_NODE",
    "GPU_MULTI_NODE"
  ]
}
