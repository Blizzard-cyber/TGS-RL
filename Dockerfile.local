ARG TGSRL_GO_BASE_IMAGE=golang:1.26.4-bookworm@sha256:b305420a68d0f229d91eb3b3ed9e519fcf2cf5461da4bef997bf927e8c0bfd2b
ARG TGSRL_PYTHON_BASE_IMAGE=python:3.12.14-slim-bookworm@sha256:0f5b26b9518d002b6173fd61daad821fa340635ebfec5bba471013f9ca114579
ARG TGSRL_NODE_BASE_IMAGE=node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

FROM ${TGSRL_GO_BASE_IMAGE} AS go-service
LABEL org.opencontainers.image.licenses="Apache-2.0"
COPY LICENSE /licenses/TGS-RL/LICENSE
ARG TGSRL_GOPROXY=https://proxy.golang.org,direct

WORKDIR /workspace
COPY go.mod go.sum ./
RUN GOPROXY="${TGSRL_GOPROXY}" go mod download

FROM ${TGSRL_PYTHON_BASE_IMAGE} AS python-service
LABEL org.opencontainers.image.licenses="Apache-2.0"
COPY LICENSE /licenses/TGS-RL/LICENSE

ARG UV_VERSION=0.12.7
ARG TGSRL_PYPI_INDEX_URL=https://pypi.org/simple
RUN python -m pip install --index-url "${TGSRL_PYPI_INDEX_URL}" --disable-pip-version-check --no-cache-dir "uv==${UV_VERSION}"

ENV UV_PROJECT_ENVIRONMENT=/opt/tgsrl/venv
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
RUN UV_DEFAULT_INDEX="${TGSRL_PYPI_INDEX_URL}" uv sync --frozen --no-dev --no-install-project

ENV PATH=/opt/tgsrl/venv/bin:$PATH

FROM ${TGSRL_NODE_BASE_IMAGE} AS console
LABEL org.opencontainers.image.licenses="Apache-2.0"
COPY LICENSE /licenses/TGS-RL/LICENSE

WORKDIR /workspace/console
ARG TGSRL_NPM_REGISTRY=https://registry.npmjs.org
COPY console ./
RUN npm ci --registry "${TGSRL_NPM_REGISTRY}"
